{
  "sourceLanguage": "en",
  "strings": {
    "settingsThreadsAutoRenameTabs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-rename tabs from their first agent prompt"
          }
        }
      }
    },
    "settingsThreadsAutoRenameTabsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses AI to generate a specific 1-3 word tab name. Manual tab names are never overwritten."
          }
        }
      }
    },
    "settingsAgentsActiveAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Agents"
          }
        }
      }
    },
    "settingsAgentsBehaviorDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls Magent-specific agent behavior like prompt injection and rate-limit monitoring."
          }
        }
      }
    },
    "settingsAgentsBehaviorTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Behavior"
          }
        }
      }
    },
    "settingsAgentsCodexAppProjectsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps Git repositories and Codex sessions organized consistently between Magent and Codex App."
          }
        }
      }
    },
    "settingsAgentsCodexAppProjectsDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magent adds missing repositories in both apps and assigns Codex sessions from every worktree to the main repository project. Projects are never removed automatically. Claude sessions are unaffected."
          }
        }
      }
    },
    "settingsAgentsCodexAppProjectsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex App Projects"
          }
        }
      }
    },
    "settingsAgentsCodexAppProjectsToggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically synchronize projects with Codex App"
          }
        }
      }
    },
    "settingsAgentsCustomAgentCommandDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command used when the active agent is set to Custom."
          }
        }
      }
    },
    "settingsAgentsCustomAgentCommandTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Agent Command"
          }
        }
      }
    },
    "settingsAgentsCustomAgentDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command used when the active agent is set to Custom."
          }
        }
      }
    },
    "settingsAgentsCustomAgentTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Agent"
          }
        }
      }
    },
    "settingsAgentsDefaultAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Agent"
          }
        }
      }
    },
    "settingsAgentsDefaultAgentDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when no agent is explicitly selected for a new chat."
          }
        }
      }
    },
    "settingsAgentsInjectIPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inject Magent IPC instructions into agent prompts"
          }
        }
      }
    },
    "settingsAgentsInjectIPCDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Injects a lightweight Magent IPC hint into Claude/Codex so the agent knows `/tmp/magent-cli` exists. Agents can load full guidance on demand via `magent-cli docs`. Disable to save tokens if you don't need agent-driven Magent control."
          }
        }
      }
    },
    "settingsAgentsSelectionDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable agents that can be launched in new chats. If multiple are enabled, choose a default."
          }
        }
      }
    },
    "settingsAgentsSelectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Selection"
          }
        }
      }
    },
    "settingsAgentsTrackRateLimits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track agent rate limits"
          }
        }
      }
    },
    "settingsAgentsRememberLastType": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember last selected type"
          }
        }
      }
    },
    "settingsAgentsRememberLastTypeDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When opening a new thread or tab, pre-select the last used type (agent or terminal) instead of always defaulting to the configured default."
          }
        }
      }
    },
    "settingsAgentsTrackRateLimitsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parse rate-limit reset times from terminal output and show a countdown in the sidebar. When off, rate-limit icons still appear while the agent is blocked but disappear once the conversation resumes."
          }
        }
      }
    },
    "settingsChatAgentBubbleColor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status background color"
          }
        }
      }
    },
    "settingsChatAgentTextColor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent text color"
          }
        }
      }
    },
    "settingsChatColorsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize chat colors with a live preview. Assistant replies stay unboxed; their background color is used for status messages."
          }
        }
      }
    },
    "settingsChatColorsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubble Colors"
          }
        }
      }
    },
