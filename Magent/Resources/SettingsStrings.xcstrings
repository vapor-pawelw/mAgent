    "settingsThreadsWideThreads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wide threads"
          }
        }
      }
    },
    "settingsThreadsWideThreadsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow thread descriptions to use two lines and size thread rows for the roomier layout."
          }
        }
      }
    },
    "settingsThreadsShowThreadIcons": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show thread icons"
          }
        }
      }
    },
    "settingsThreadsShowThreadIconsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, thread names and badges shift left and the icon picker is hidden from thread menus."
          }
        }
      }
    },
    "settingsThreadsShowWorktreeNames": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show worktree names"
          }
        }
      }
    },
    "settingsThreadsShowWorktreeNamesDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include the worktree folder name on the second line of thread rows when it differs from the branch."
          }
        }
      }
    },
