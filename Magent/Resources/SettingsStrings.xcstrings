    "settingsChatResetColors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to defaults"
          }
        }
      }
    },
    "settingsChatResetColorsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears custom chat colors. The user bubble follows the app primary color, while the agent bubble returns to its neutral default."
          }
        }
      }
    },
    "settingsChatUserBubbleColor": {
      "extractionState": "manual",
