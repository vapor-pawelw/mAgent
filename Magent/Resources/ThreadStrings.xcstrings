    "threadArchiveDestructiveDirtyInfo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worktree at %@ has uncommitted or untracked changes. Commit & Archive will ask for a commit message (default: \"Uncommitted changes on <branch> (<worktree>)\") and then archive removes the worktree directory."
          }
        }
      }
    },
    "threadArchiveDestructiveDirtyInfoDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worktree at %@ has uncommitted or untracked changes. Commit & Archive will prompt for a commit message before archiving this worktree."
          }
        }
      }
    },
    "threadArchiveDestructiveDirtyIgnoredPrefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAlso about to be deleted (not tracked by git, not recoverable by restore):\n  "
          }
        }
      }
    },
    "threadArchiveDestructiveIgnoredInfo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worktree at %@ is clean, but contains files ignored by git (notes, local config, secrets, etc.) that will be deleted with the directory. These are not on any branch and restore cannot recover them:\n  "
          }
        }
      }
    },
    "threadArchiveDestructiveIgnoredInfoDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
